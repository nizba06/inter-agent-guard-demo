# IntelBrief — copy to .env and adjust

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Real LLM (default: Ollama + llama3.2)
LLM_BACKEND=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI alternative (set LLM_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# AgentGuard
AGENTGUARD_MODE=enforce
REQUIRE_ML_MODEL=true
ENABLE_TRUST_ATTESTATION=true

# Fixtures: http (via API /fixtures) or local (local:// files on disk)
FIXTURE_MODE=http

# UI
INTELBRIEF_API_URL=http://127.0.0.1:8000/api/v1
